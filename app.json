{
  "expo": {
    "name": "Admin Panel",
    "slug": "admin-apk",
    "version": "1.0.0",
    "icon": "./assets/app-icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "backgroundColor": "#ffffff",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vetansutra.admin"
    },
    "android": {
      "package": "com.vetansutra.admin",
      "targetSdkVersion": 35,
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.INTERNET"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "e6a27490-2ad3-4737-bb5d-0ba7c7de686a"
      }
    },
    "owner": "asitman123",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/e6a27490-2ad3-4737-bb5d-0ba7c7de686a"
    }
  }
}
